rules_version = '2';

// VendeFrío - Reglas de seguridad de Firestore (T8, T9, T14, T15, T18, T19, T20,
// T22, T23, T24, T25, T26)
// Se publican a mano en la consola de Firebase (tareas M3, M5 y M6, y al final
// de cada tarea que lo cambia; volver a publicar cada vez que cambia este
// archivo).
//
// Estructura:
//   usuarios/{uid}                  a qué distribuidora pertenece cada usuario
//   codigosAcceso/{codigo}          códigos de ingreso de empleados (T14):
//                                   sirven una vez y vencen a las 24 horas
//   distribuidoras/{idDistribuidora}   el id es el uid del dueño, o "prueba-" + uid
//                                   para la distribuidora de prueba (T9);
//                                   nombreDueno: el nombre del dueño (T18)
//     miembros/{uid}                usuarios autorizados (dueño y empleados)
//     empleados/{idEmpleado}        ficha de cada empleado (T14): la persona,
//                                   no el celular
//     comercios/{id}
//     productos/{id}
//     config/{id}                   config/marcas (orden de marcas) y
//                                   config/roles (lista de roles con sus
//                                   permisos y copia por permiso, solo el
//                                   dueño; T19)
//     pedidos/{id}                  con estado, autor y precios (T20); el
//                                   historial de estados va adentro, en el
//                                   campo "estados", y solo se agrega; cada
//                                   estado, solo con su permiso, y las
//                                   incidencias en "incidencias" e
//                                   "incidenciasResueltas" (T22); la
//                                   checklist en "preparacion" y
//                                   "faltantes" (T24), que solo se agregan;
//                                   las ediciones del autor o el dueño en
//                                   "ediciones" y quién las vio en
//                                   "edicionesVistas" (T25), que solo se
//                                   agregan; nunca se borra: eliminar lo
//                                   marca como eliminado y cancelar es un
//                                   estado más, los dos solo del autor o el
//                                   dueño (T26)
//     rutas/{id}
//     avisos/{idPersona}/recibidos/{idAviso}   avisos de cada persona (T23)
//     preferenciasAvisos/{idPersona}   qué avisos recibe cada persona (T23)
//
// Solo los miembros de una distribuidora leen y escriben sus datos.
// Todo lo que no figura acá queda bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {

    function ingreso() {
      return request.auth != null;
    }

    // Cuenta anónima (T14): la de los empleados, sin email ni contraseña.
    function esAnonimo() {
      return request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function rutaDistribuidora(idDistribuidora) {
      return /databases/$(database)/documents/distribuidoras/$(idDistribuidora);
    }

    function rutaMiembro(idDistribuidora, uid) {
      return /databases/$(database)/documents/distribuidoras/$(idDistribuidora)/miembros/$(uid);
    }

    function rutaEmpleado(idDistribuidora, idEmpleado) {
      return /databases/$(database)/documents/distribuidoras/$(idDistribuidora)/empleados/$(idEmpleado);
    }

    function rutaCodigo(codigo) {
      return /databases/$(database)/documents/codigosAcceso/$(codigo);
    }

    function esMiembro(idDistribuidora) {
      return ingreso()
        && exists(rutaMiembro(idDistribuidora, request.auth.uid));
    }

    function esDueno(idDistribuidora) {
      return ingreso()
        && get(rutaDistribuidora(idDistribuidora)).data.duenoUid == request.auth.uid;
    }

    // 8 caracteres sin letras que se confundan (sin 0/O ni 1/I).
    function codigoValido(codigo) {
      return codigo is string
        && codigo.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$');
    }

    function idValido(id) {
      return id is string && id.matches('^[A-Za-z0-9]{1,40}$');
    }

    // Permisos por rol (T19). config/roles guarda la lista de roles (cada uno
    // con sus permisos) y, en el mismo documento, porPermiso: para cada
    // permiso, los ids de rol que lo tienen. Así las próximas reglas revisan
    // un permiso sin recorrer la lista.
    function permisosValidos(porPermiso) {
      return porPermiso is map
        && porPermiso.keys().hasAll(["prepara", "reparte", "cobra", "avisoFaltantes", "controla"])
        && porPermiso.keys().hasOnly(["prepara", "reparte", "cobra", "avisoFaltantes", "controla"])
        && porPermiso.prepara is list && porPermiso.prepara.size() <= 50
        && porPermiso.reparte is list && porPermiso.reparte.size() <= 50
        && porPermiso.cobra is list && porPermiso.cobra.size() <= 50
        && porPermiso.avisoFaltantes is list && porPermiso.avisoFaltantes.size() <= 50
        && porPermiso.controla is list && porPermiso.controla.size() <= 50;
    }

    // Pedido completo (T20). Los pedidos guardan quién los cargó y quién
    // hizo cada cambio de estado como una "persona": { idPersona, nombre,
    // uid }. idPersona es "dueno" o el id de la ficha del empleado (no cambia
    // con un reingreso).
    function estadoDePedidoValido(estado) {
      return estado in ["cargado", "enPreparacion", "preparado", "enVehiculo", "enReparto", "entregado", "cancelado"];
    }

    function miIdPersona(idDistribuidora) {
      return esDueno(idDistribuidora)
        ? "dueno"
        : get(rutaMiembro(idDistribuidora, request.auth.uid)).data.get("idEmpleado", "");
    }

    // Siempre a nombre de quien escribe, nunca de otro.
    function personaPropia(idDistribuidora, persona) {
      return persona is map
        && persona.keys().hasAll(["idPersona", "nombre", "uid"])
        && persona.keys().hasOnly(["idPersona", "nombre", "uid"])
        && persona.uid == request.auth.uid
        && persona.idPersona == miIdPersona(idDistribuidora)
        && persona.nombre is string
        && persona.nombre.size() <= 60;
    }

    // Una entrada del historial de estados.
    function entradaDeEstadoValida(idDistribuidora, entrada) {
      return entrada is map
        && entrada.keys().hasAll(["estado", "persona", "horaCelular", "nota"])
        && entrada.keys().hasOnly(["estado", "persona", "horaCelular", "nota"])
        && estadoDePedidoValido(entrada.estado)
        && personaPropia(idDistribuidora, entrada.persona)
        && entrada.horaCelular is number
        && entrada.nota is string
        && entrada.nota.size() <= 300;
    }

    // Sin autor ni historial de estados: los subidos con T11 y los que carga
    // un celular con una versión vieja de la app. La app los muestra como
    // "Histórico". Se aceptan para no perder esos pedidos.
    function pedidoSinEstados(pedido) {
      return !("autor" in pedido)
        && !("estados" in pedido)
        && pedido.get("estado", "historico") == "historico";
    }

    // Un pedido nuevo nace "Cargado", a nombre de quien lo carga, con una
    // sola entrada en el historial de estados.
    function pedidoNuevoPropio(idDistribuidora, pedido) {
      return pedido.keys().hasAll(["comercio", "productos", "estado", "autor", "estados", "eliminado"])
        && pedido.keys().hasOnly(["id", "_orden", "fecha", "timestamp", "comercio", "cantidad", "pedido",
          "productos", "observaciones", "estado", "autor", "estados", "eliminado"])
        && pedido.comercio is string
        && pedido.productos is list
        && pedido.estado == "cargado"
        && pedido.eliminado == false
        && personaPropia(idDistribuidora, pedido.autor)
        && pedido.estados is map
        && pedido.estados.size() == 1
        && entradaDeEstadoValida(idDistribuidora, pedido.estados[pedido.estados.keys()[0]])
        && pedido.estados[pedido.estados.keys()[0]].estado == "cargado"
        && pedido.estados[pedido.estados.keys()[0]].persona == pedido.autor;
    }

    // Lo que se pidió (productos, comercio y observaciones, y el texto y las
    // unidades que salen de ellos) solo lo cambian el autor y el dueño. Un
    // "Histórico" no tiene autor: solo el dueño.
    function puedeCambiarLoPedido(idDistribuidora, pedido) {
      return esDueno(idDistribuidora)
        || ("autor" in pedido && pedido.autor.idPersona == miIdPersona(idDistribuidora));
    }

    // Permisos de quien escribe (T22). El dueño tiene todos. El empleado,
    // los de cualquiera de sus roles, según la copia por permiso de
    // config/roles (T19).
    function tienePermiso(idDistribuidora, permiso) {
      return esDueno(idDistribuidora)
        || get(rutaEmpleado(idDistribuidora, miIdPersona(idDistribuidora))).data.get("roles", [])
          .hasAny(get(/databases/$(database)/documents/distribuidoras/$(idDistribuidora)/config/roles)
            .data.porPermiso.get(permiso, []));
    }

    // Cancelar (T26): solo quien cargó el pedido o el dueño, con motivo y
    // antes de "Entregado". Para saber si ya se entregó se usa la copia del
    // estado (la del último cambio que llegó): un cancelado hecho sin señal
    // que llega después de la entrega se rechaza, como corresponde.
    function cancelacionValida(idDistribuidora, antes, entrada) {
      return puedeCambiarLoPedido(idDistribuidora, antes)
        && textoObligatorio(entrada.nota)
        && antes.get("estado", "") != "entregado";
    }

    // Quién puede poner cada estado (T22). Se revisa el estado al que va, no
    // del que viene: dos cambios hechos sin señal pueden llegar desordenados
    // y los dos tienen que quedar en el historial (T17). Cada paso lo hace
    // quien tiene su permiso, y el mismo permiso lo vuelve atrás:
    //   "Prepara pedidos": Cargado <-> En preparación <-> Preparado.
    //   "Reparte": Preparado <-> Cargado en el vehículo <-> En reparto.
    //   "Controla pedidos" y el dueño: todos.
    // "Cancelado", solo el autor o el dueño (T26). "Entregado" lo limita T27.
    function puedePonerEstado(idDistribuidora, antes, entrada) {
      return entrada.estado == "cancelado"
        ? cancelacionValida(idDistribuidora, antes, entrada)
        : (entrada.estado == "entregado"
          || tienePermiso(idDistribuidora, "controla")
          || (entrada.estado in ["cargado", "enPreparacion", "preparado"] && tienePermiso(idDistribuidora, "prepara"))
          || (entrada.estado in ["preparado", "enVehiculo", "enReparto"] && tienePermiso(idDistribuidora, "reparte")));
    }

    // El historial de estados solo se agrega: una entrada por cambio, a
    // nombre de quien escribe, sin tocar las que ya están, y con el permiso
    // de ese estado (T22).
    function estadoAgregadoValido(idDistribuidora, antes, despues) {
      let nuevas = despues.estados.keys().removeAll(antes.estados.keys());
      return despues.estados is map
        && despues.estados.diff(antes.estados).changedKeys().size() == 0
        && despues.estados.diff(antes.estados).removedKeys().size() == 0
        && nuevas.size() == 1
        && entradaDeEstadoValida(idDistribuidora, despues.estados[nuevas[0]])
        && estadoDePedidoValido(despues.estado)
        && puedePonerEstado(idDistribuidora, antes, despues.estados[nuevas[0]]);
    }

    // Incidencias (T22): se marcan encima del estado, sin reemplazarlo. Cada
    // una es una entrada del mapa "incidencias": { motivo, persona,
    // horaCelular }. Al resolverla se suma, con el mismo id, una entrada en
    // "incidenciasResueltas": { nota, persona, horaCelular }. Las dos solo se
    // agregan: nunca se cambian ni se borran.
    function textoObligatorio(texto) {
      return texto is string && texto.size() >= 1 && texto.size() <= 300;
    }

    // Una incidencia nueva: una sola entrada agregada, sin tocar las demás.
    // Cualquier miembro la marca, con motivo y a nombre propio.
    function incidenciaAgregadaValida(idDistribuidora, antes, despues) {
      let previas = antes.get("incidencias", {});
      let nuevas = despues.incidencias.keys().removeAll(previas.keys());
      let incidencia = despues.incidencias[nuevas[0]];
      return despues.incidencias.diff(previas).affectedKeys().size() == 1
        && nuevas.size() == 1
        && incidencia is map
        && incidencia.keys().hasAll(["motivo", "persona", "horaCelular"])
        && incidencia.keys().hasOnly(["motivo", "persona", "horaCelular"])
        && textoObligatorio(incidencia.motivo)
        && incidencia.horaCelular is number
        && personaPropia(idDistribuidora, incidencia.persona);
    }

    // Resolver una incidencia que existe: una sola entrada agregada, con el
    // mismo id. Solo el dueño o "Controla pedidos", con nota y a nombre
    // propio.
    function resolucionAgregadaValida(idDistribuidora, antes, despues) {
      let previas = antes.get("incidenciasResueltas", {});
      let nuevas = despues.incidenciasResueltas.keys().removeAll(previas.keys());
      let resolucion = despues.incidenciasResueltas[nuevas[0]];
      return despues.incidenciasResueltas.diff(previas).affectedKeys().size() == 1
        && nuevas.size() == 1
        && nuevas[0] in despues.get("incidencias", {})
        && resolucion is map
        && resolucion.keys().hasAll(["nota", "persona", "horaCelular"])
        && resolucion.keys().hasOnly(["nota", "persona", "horaCelular"])
        && textoObligatorio(resolucion.nota)
        && resolucion.horaCelular is number
        && personaPropia(idDistribuidora, resolucion.persona)
        && tienePermiso(idDistribuidora, "controla");
    }

    // Checklist de preparación (T24). Cada tilde o destilde es una entrada
    // nueva de "preparacion": { linea, tildado, persona, horaCelular }.
    // Cada faltante (o su corrección) es una entrada nueva de "faltantes":
    // { linea, preparada, observacion, persona, horaCelular }; preparada
    // null (con observación vacía) quita el faltante. Las dos solo se
    // agregan, de a una por escritura y a nombre propio: dos personas que
    // arman el mismo pedido no se pisan y siempre se ve quién hizo qué. No
    // se revisa el estado del pedido (un tilde hecho sin señal puede llegar
    // después de "Preparado"): eso lo cuida la app.
    function lineaValida(linea) {
      return linea is string && linea.matches('^[A-Za-z0-9_]{1,100}$');
    }

    // Cualquier miembro tilda y destilda.
    function tildeAgregadoValido(idDistribuidora, antes, despues) {
      let previas = antes.get("preparacion", {});
      let nuevas = despues.preparacion.keys().removeAll(previas.keys());
      let tilde = despues.preparacion[nuevas[0]];
      return despues.preparacion.diff(previas).affectedKeys().size() == 1
        && nuevas.size() == 1
        && tilde is map
        && tilde.keys().hasAll(["linea", "tildado", "persona", "horaCelular"])
        && tilde.keys().hasOnly(["linea", "tildado", "persona", "horaCelular"])
        && lineaValida(tilde.linea)
        && tilde.tildado is bool
        && tilde.horaCelular is number
        && personaPropia(idDistribuidora, tilde.persona);
    }

    // Faltantes: solo "Prepara pedidos" (y "Controla pedidos" y el dueño).
    // Lo preparado es un número entero desde 0, con observación obligatoria.
    function faltanteAgregadoValido(idDistribuidora, antes, despues) {
      let previas = antes.get("faltantes", {});
      let nuevas = despues.faltantes.keys().removeAll(previas.keys());
      let faltante = despues.faltantes[nuevas[0]];
      return despues.faltantes.diff(previas).affectedKeys().size() == 1
        && nuevas.size() == 1
        && faltante is map
        && faltante.keys().hasAll(["linea", "preparada", "observacion", "persona", "horaCelular"])
        && faltante.keys().hasOnly(["linea", "preparada", "observacion", "persona", "horaCelular"])
        && lineaValida(faltante.linea)
        && ((faltante.preparada == null && faltante.observacion == "")
          || (faltante.preparada is int && faltante.preparada >= 0 && faltante.preparada <= 100000
            && textoObligatorio(faltante.observacion)))
        && faltante.horaCelular is number
        && personaPropia(idDistribuidora, faltante.persona)
        && (tienePermiso(idDistribuidora, "prepara") || tienePermiso(idDistribuidora, "controla"));
    }

    // Editar el pedido (T25). Cada edición es una entrada nueva de
    // "ediciones": { texto, revisar, estado, persona, horaCelular }. texto es
    // lo que cambió ("Agregó 2 Coca 2L · Quitó Sprite"), revisar los
    // productos que la checklist marca para revisar (id de línea -> "Nuevo"
    // o "Antes x3") y estado, el del pedido al editarlo. Solo el autor y el
    // dueño, a nombre propio, de a una y sin cambiar ni borrar las
    // anteriores: la edición queda en el seguimiento.
    function edicionAgregadaValida(idDistribuidora, antes, despues) {
      let previas = antes.get("ediciones", {});
      let nuevas = despues.ediciones.keys().removeAll(previas.keys());
      let edicion = despues.ediciones[nuevas[0]];
      return despues.ediciones.diff(previas).affectedKeys().size() == 1
        && nuevas.size() == 1
        && edicion is map
        && edicion.keys().hasAll(["texto", "revisar", "estado", "persona", "horaCelular"])
        && edicion.keys().hasOnly(["texto", "revisar", "estado", "persona", "horaCelular"])
        && edicion.texto is string
        && edicion.texto.size() >= 1
        && edicion.texto.size() <= 1000
        && edicion.revisar is map
        && edicion.revisar.size() <= 200
        && estadoDePedidoValido(edicion.estado)
        && edicion.horaCelular is number
        && personaPropia(idDistribuidora, edicion.persona)
        && puedeCambiarLoPedido(idDistribuidora, antes);
    }

    // "Entendido" (T25): cada persona cierra la franja amarilla de una
    // edición con una entrada nueva de "edicionesVistas": { edicion, persona,
    // horaCelular }. Cualquier miembro, a nombre propio, de a una y sobre una
    // edición que existe.
    function vistaAgregadaValida(idDistribuidora, antes, despues) {
      let previas = antes.get("edicionesVistas", {});
      let nuevas = despues.edicionesVistas.keys().removeAll(previas.keys());
      let vista = despues.edicionesVistas[nuevas[0]];
      return despues.edicionesVistas.diff(previas).affectedKeys().size() == 1
        && nuevas.size() == 1
        && vista is map
        && vista.keys().hasAll(["edicion", "persona", "horaCelular"])
        && vista.keys().hasOnly(["edicion", "persona", "horaCelular"])
        && vista.edicion is string
        && vista.edicion in despues.get("ediciones", {})
        && vista.horaCelular is number
        && personaPropia(idDistribuidora, vista.persona);
    }

    // Eliminar (T26): el pedido no se borra nunca. Queda guardado por dentro
    // con eliminado: true y "eliminacion": { persona, horaCelular } (quién y
    // cuándo), en una escritura sola. Solo quien lo cargó o el dueño, y solo
    // mientras está "Cargado" (según la copia del estado, como al cancelar).
    // Un "Histórico" no tiene autor: solo el dueño.
    function eliminacionValida(idDistribuidora, antes, despues) {
      return despues.diff(antes).affectedKeys().hasOnly(["eliminado", "eliminacion"])
        && despues.eliminado == true
        && despues.eliminacion is map
        && despues.eliminacion.keys().hasAll(["persona", "horaCelular"])
        && despues.eliminacion.keys().hasOnly(["persona", "horaCelular"])
        && despues.eliminacion.horaCelular is number
        && personaPropia(idDistribuidora, despues.eliminacion.persona)
        && (("estados" in antes)
          ? (antes.get("estado", "") == "cargado" && puedeCambiarLoPedido(idDistribuidora, antes))
          : esDueno(idDistribuidora));
    }

    // Cada cambio se guarda campo por campo. El id, la fecha y el autor no
    // cambian, y la marca de eliminado solo pasa a true al eliminar (T26).
    // Un pedido eliminado ya no cambia (salvo su lugar en la lista). El
    // estado cambia solo junto con una entrada nueva del historial, y un
    // "Histórico" no pasa a tener estados, incidencias, checklist ni
    // ediciones. En un pedido con estados, lo pedido cambia solo junto con
    // una edición nueva (T25).
    function cambioDePedidoValido(idDistribuidora, antes, despues) {
      let cambiados = despues.diff(antes).affectedKeys();
      return cambiados.hasOnly(["_orden", "estado", "estados", "incidencias", "incidenciasResueltas", "preparacion",
          "faltantes", "entrega", "cobro", "ediciones", "edicionesVistas", "productos", "comercio", "observaciones",
          "pedido", "cantidad", "eliminado", "eliminacion"])
        && (antes.get("eliminado", false) != true || cambiados.hasOnly(["_orden"]))
        && (!cambiados.hasAny(["eliminado", "eliminacion"]) || eliminacionValida(idDistribuidora, antes, despues))
        && (!cambiados.hasAny(["productos", "comercio", "observaciones", "pedido", "cantidad"])
          || (puedeCambiarLoPedido(idDistribuidora, antes)
            && (!("estados" in antes) || cambiados.hasAny(["ediciones"]))))
        && (!cambiados.hasAny(["ediciones"])
          || ("estados" in antes && edicionAgregadaValida(idDistribuidora, antes, despues)))
        && (!cambiados.hasAny(["edicionesVistas"])
          || ("estados" in antes && vistaAgregadaValida(idDistribuidora, antes, despues)))
        && (!cambiados.hasAny(["estado", "estados"])
          || ("estados" in antes && estadoAgregadoValido(idDistribuidora, antes, despues)))
        && (!cambiados.hasAny(["incidencias"])
          || ("estados" in antes && incidenciaAgregadaValida(idDistribuidora, antes, despues)))
        && (!cambiados.hasAny(["incidenciasResueltas"])
          || ("estados" in antes && resolucionAgregadaValida(idDistribuidora, antes, despues)))
        && (!cambiados.hasAny(["preparacion"])
          || ("estados" in antes && tildeAgregadoValido(idDistribuidora, antes, despues)))
        && (!cambiados.hasAny(["faltantes"])
          || ("estados" in antes && faltanteAgregadoValido(idDistribuidora, antes, despues)));
    }

    // Avisos dentro de la app (T23). Cada persona tiene su buzón:
    // avisos/{idPersona}/recibidos/{idAviso}. Quien hace el cambio deja una
    // copia del aviso en el buzón de cada destinatario, nunca en el suyo
    // (nadie recibe aviso de lo que hizo él mismo). Cada uno lee, marca como
    // leídos y limpia solo los suyos.
    function rutaPedido(idDistribuidora, idPedido) {
      return /databases/$(database)/documents/distribuidoras/$(idDistribuidora)/pedidos/$(idPedido);
    }

    function idPersonaValida(idPersona) {
      return idPersona == "dueno" || idValido(idPersona);
    }

    function avisoNuevoValido(idDistribuidora, aviso) {
      return aviso.keys().hasAll(["tipo", "idPedido", "comercio", "detalle", "persona", "horaCelular", "leido"])
        && aviso.keys().hasOnly(["tipo", "idPedido", "comercio", "detalle", "persona", "horaCelular", "leido"])
        && aviso.tipo in ["pedidoNuevo", "incidencia", "incidenciaResuelta", "preparado", "faltante", "pedidoEditado",
          "pedidoCancelado"]
        && aviso.idPedido is string
        && aviso.idPedido.matches('^[A-Za-z0-9_-]{1,100}$')
        && aviso.comercio is string
        && aviso.comercio.size() <= 120
        && aviso.detalle is string
        && aviso.detalle.size() <= 300
        && aviso.horaCelular is number
        && aviso.leido == null
        && personaPropia(idDistribuidora, aviso.persona)
        && existsAfter(rutaPedido(idDistribuidora, aviso.idPedido));
    }

    function vigente(datosCodigo) {
      return request.time < datosCodigo.creado + duration.value(24, 'h');
    }

    // Canje de un código (T14): el código era de esta distribuidora y de esta
    // ficha, no estaba usado, no venció y en esta misma tanda queda usado por
    // esta cuenta. Así sirve una sola vez.
    function canjeEnEstaTanda(idDistribuidora, codigo, idEmpleado) {
      let antes = get(rutaCodigo(codigo)).data;
      let despues = getAfter(rutaCodigo(codigo)).data;
      return antes.idDistribuidora == idDistribuidora
        && antes.idEmpleado == idEmpleado
        && antes.usado == false
        && vigente(antes)
        && despues.usado == true
        && despues.usadoPor == request.auth.uid;
    }

    // La ficha de empleado se toca en la misma tanda en que esta cuenta se
    // suma como miembro con un código del tipo indicado ("alta" o "reingreso").
    function fichaDeCanje(idDistribuidora, idEmpleado, tipo) {
      let miembro = getAfter(rutaMiembro(idDistribuidora, request.auth.uid)).data;
      return !exists(rutaMiembro(idDistribuidora, request.auth.uid))
        && miembro.rol == "empleado"
        && miembro.idEmpleado == idEmpleado
        && get(rutaCodigo(miembro.codigo)).data.tipo == tipo;
    }

    // Ficha de cada usuario: dice a qué distribuidora pertenece.
    // La crea el dueño al primer ingreso, junto con su distribuidora, o el
    // empleado al usar su código (T14).
    match /usuarios/{uid} {
      allow read: if ingreso() && request.auth.uid == uid;

      allow create: if ingreso()
        && request.auth.uid == uid
        && (
          (request.resource.data.keys().hasOnly(["idDistribuidora", "alta"])
            && request.resource.data.idDistribuidora == uid
            && getAfter(rutaDistribuidora(uid)).data.duenoUid == uid)
          ||
          (esAnonimo()
            && request.resource.data.keys().hasOnly(["idDistribuidora", "idEmpleado", "alta"])
            && idValido(request.resource.data.idDistribuidora)
            && getAfter(rutaMiembro(request.resource.data.idDistribuidora, uid)).data.rol == "empleado"
            && getAfter(rutaMiembro(request.resource.data.idDistribuidora, uid)).data.idEmpleado
                == request.resource.data.idEmpleado)
        );

      allow update, delete: if false;
    }

    // Códigos de acceso de empleados (T14). El id es el código.
    // Saber el código es el permiso: se lee de a uno, nunca la lista entera
    // (salvo el dueño, que ve solo los suyos).
    match /codigosAcceso/{codigo} {
      allow get: if ingreso();

      allow list: if ingreso()
        && resource.data.idDistribuidora == request.auth.uid;

      // Solo el dueño crea códigos para su distribuidora real.
      // "alta": para una ficha nueva. "reingreso": para una ficha que ya
      // existe; guarda la cuenta que la usa hoy, que pierde el acceso.
      allow create: if ingreso()
        && !esAnonimo()
        && codigoValido(codigo)
        && request.resource.data.keys().hasAll(["idDistribuidora", "idEmpleado", "tipo", "creado", "usado"])
        && request.resource.data.keys().hasOnly(["idDistribuidora", "idEmpleado", "tipo", "creado", "usado", "uidAnterior"])
        && request.resource.data.idDistribuidora == request.auth.uid
        && esDueno(request.auth.uid)
        && request.resource.data.usado == false
        && request.resource.data.creado == request.time
        && idValido(request.resource.data.idEmpleado)
        && (
          (request.resource.data.tipo == "alta"
            && !("uidAnterior" in request.resource.data)
            && !exists(rutaEmpleado(request.auth.uid, request.resource.data.idEmpleado)))
          ||
          (request.resource.data.tipo == "reingreso"
            && request.resource.data.uidAnterior
                == get(rutaEmpleado(request.auth.uid, request.resource.data.idEmpleado)).data.uidActual
            // Una ficha dada de baja no vuelve con reingreso (T15).
            && get(rutaEmpleado(request.auth.uid, request.resource.data.idEmpleado)).data.activo == true)
        );

      // Usar el código: lo marca la cuenta anónima del empleado, en la misma
      // tanda en que se suma como miembro con este código.
      allow update: if ingreso()
        && esAnonimo()
        && resource.data.usado == false
        && vigente(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usado", "usadoPor", "usadoEn"])
        && request.resource.data.usado == true
        && request.resource.data.usadoPor == request.auth.uid
        && request.resource.data.usadoEn == request.time
        && getAfter(rutaMiembro(resource.data.idDistribuidora, request.auth.uid)).data.codigo == codigo;

      // Anular un código sin usar (T15): solo el dueño que lo creó.
      allow delete: if ingreso()
        && !esAnonimo()
        && resource.data.idDistribuidora == request.auth.uid
        && resource.data.usado == false;
    }

    match /distribuidoras/{idDistribuidora} {
      allow read: if esMiembro(idDistribuidora);

      // Al primer ingreso del dueño: la distribuidora usa su uid como id,
      // así cada dueño crea una sola, y se crea junto con su ficha de miembro.
      // Cada dueño puede crear además una sola distribuidora de prueba
      // ("prueba-" + uid, con prueba: true) para el modo prueba (T9).
      // Una cuenta anónima (empleado) nunca crea una distribuidora (T14).
      allow create: if ingreso()
        && !esAnonimo()
        && (idDistribuidora == request.auth.uid
            || idDistribuidora == "prueba-" + request.auth.uid)
        && request.resource.data.keys().hasOnly(["nombre", "duenoUid", "creada", "prueba"])
        && request.resource.data.get("prueba", false) == (idDistribuidora != request.auth.uid)
        && request.resource.data.duenoUid == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 80
        && existsAfter(rutaMiembro(idDistribuidora, request.auth.uid));

      // El dueño puede cambiar el nombre de la distribuidora y el suyo
      // (nombreDueno, T18: obligatorio, hasta 60 caracteres), nunca quién es
      // el dueño.
      allow update: if esDueno(idDistribuidora)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nombre", "nombreDueno"])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 80
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["nombreDueno"])
          || (request.resource.data.get("nombreDueno", null) is string
            && request.resource.data.nombreDueno.size() >= 1
            && request.resource.data.nombreDueno.size() <= 60));

      allow delete: if false;

      // Usuarios autorizados: el dueño y los empleados que entraron con un
      // código (T14).
      match /miembros/{uid} {
        allow read: if esMiembro(idDistribuidora);

        allow create: if ingreso()
          && request.auth.uid == uid
          && (
            (getAfter(rutaDistribuidora(idDistribuidora)).data.duenoUid == uid
              && request.resource.data.keys().hasOnly(["email", "rol", "alta"])
              && request.resource.data.rol == "dueno")
            ||
            (esAnonimo()
              && request.resource.data.keys().hasAll(["rol", "idEmpleado", "codigo", "alta"])
              && request.resource.data.keys().hasOnly(["rol", "idEmpleado", "codigo", "alta"])
              && request.resource.data.rol == "empleado"
              && request.resource.data.alta == request.time
              && codigoValido(request.resource.data.codigo)
              && idValido(request.resource.data.idEmpleado)
              && canjeEnEstaTanda(idDistribuidora, request.resource.data.codigo, request.resource.data.idEmpleado)
              && getAfter(rutaEmpleado(idDistribuidora, request.resource.data.idEmpleado)).data.uidActual == uid)
          );

        allow update: if false;

        // Reingreso (T14): el celular nuevo le quita el acceso al viejo, en la
        // misma tanda en que la ficha del empleado pasa a la cuenta nueva.
        // Baja (T15): el dueño le quita el acceso a un empleado, en la misma
        // tanda en que su ficha queda como "dado de baja".
        allow delete: if ingreso()
          && uid != request.auth.uid
          && resource.data.rol == "empleado"
          && (getAfter(rutaEmpleado(idDistribuidora, resource.data.idEmpleado)).data.uidActual == request.auth.uid
            || (esDueno(idDistribuidora)
              && getAfter(rutaEmpleado(idDistribuidora, resource.data.idEmpleado)).data.activo == false));
      }

      // Ficha de cada empleado (T14). Nace cuando el empleado usa un código
      // de alta del dueño; el empleado solo cambia su nombre y sus roles.
      // El dueño cambia los roles y da de baja (T15). Nunca se borra.
      match /empleados/{idEmpleado} {
        // Un empleado dado de baja puede leer solo su propia ficha, para que
        // su celular sepa que fue una baja (T15). No ve nada más.
        allow read: if esMiembro(idDistribuidora)
          || (ingreso() && resource.data.uidActual == request.auth.uid);

        allow create: if ingreso()
          && esAnonimo()
          && request.resource.data.keys().hasOnly(["nombre", "roles", "activo", "uidActual", "alta"])
          && request.resource.data.nombre == ""
          && request.resource.data.roles == []
          && request.resource.data.activo == true
          && request.resource.data.uidActual == request.auth.uid
          && request.resource.data.alta == request.time
          && fichaDeCanje(idDistribuidora, idEmpleado, "alta");

        allow update: if ingreso()
          && (
            // El empleado cambia solo su nombre (obligatorio) y sus roles.
            (resource.data.uidActual == request.auth.uid
              && esMiembro(idDistribuidora)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nombre", "roles"])
              && request.resource.data.nombre is string
              && request.resource.data.nombre.size() >= 1
              && request.resource.data.nombre.size() <= 60
              && request.resource.data.roles is list
              && request.resource.data.roles.size() <= 20)
            ||
            // Reingreso: la ficha pasa a la cuenta nueva y la vieja deja de
            // ser miembro en la misma tanda. Solo si la ficha está activa.
            (esAnonimo()
              && resource.data.activo == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uidActual"])
              && request.resource.data.uidActual == request.auth.uid
              && fichaDeCanje(idDistribuidora, idEmpleado, "reingreso")
              && !existsAfter(rutaMiembro(idDistribuidora, resource.data.uidActual)))
            ||
            // El dueño cambia los roles de un empleado (T15).
            (esDueno(idDistribuidora)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roles"])
              && request.resource.data.roles is list
              && request.resource.data.roles.size() <= 20)
            ||
            // Baja (T15): la ficha queda como "dado de baja" y, en la misma
            // tanda, su cuenta deja de ser miembro. No hay vuelta atrás: para
            // volver hace falta un código de alta nuevo (otra ficha).
            (esDueno(idDistribuidora)
              && resource.data.activo == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activo", "baja"])
              && request.resource.data.activo == false
              && request.resource.data.baja == request.time
              && !existsAfter(rutaMiembro(idDistribuidora, resource.data.uidActual)))
          );

        allow delete: if false;
      }

      match /comercios/{id} {
        allow read, write: if esMiembro(idDistribuidora);
      }

      match /productos/{id} {
        allow read, write: if esMiembro(idDistribuidora);
      }

      // config/roles (lista de roles) solo la escribe el dueño (T14). Desde
      // T19 lleva siempre los permisos: la lista, la copia por permiso y la
      // marca de que los precargados ya recibieron los suyos se escriben
      // juntas, en el mismo documento. Una versión vieja de la app (que
      // guardaba solo la lista y borraría los permisos) no puede escribirla.
      match /config/{id} {
        allow read: if esMiembro(idDistribuidora);
        allow write: if esMiembro(idDistribuidora) && id != "roles";

        allow create, update: if id == "roles"
          && esDueno(idDistribuidora)
          && request.resource.data.keys().hasAll(["lista", "porPermiso", "permisosIniciales"])
          && request.resource.data.keys().hasOnly(["lista", "porPermiso", "permisosIniciales"])
          && request.resource.data.lista is list
          && request.resource.data.lista.size() <= 50
          && permisosValidos(request.resource.data.porPermiso)
          && request.resource.data.permisosIniciales == true;
      }

      match /rutas/{id} {
        allow read, write: if esMiembro(idDistribuidora);
      }

      // Pedidos (T20). El historial de estados va dentro de cada pedido (se
      // lee junto con él) y reemplaza a la subcolección "estados", que nunca
      // se usó. El dueño puede crear cualquier pedido (por ejemplo, al
      // combinar un respaldo). Desde T26 nadie borra un pedido de verdad:
      // eliminar lo marca como eliminado (ver eliminacionValida).
      match /pedidos/{id} {
        allow read: if esMiembro(idDistribuidora);

        allow create: if esMiembro(idDistribuidora)
          && (pedidoSinEstados(request.resource.data)
            || pedidoNuevoPropio(idDistribuidora, request.resource.data)
            || esDueno(idDistribuidora));

        allow update: if esMiembro(idDistribuidora)
          && cambioDePedidoValido(idDistribuidora, resource.data, request.resource.data);

        allow delete: if false;
      }

      // Avisos (T23): el buzón de cada persona ("dueno" o el id de la ficha
      // del empleado, que no cambia con un reingreso).
      match /avisos/{idPersona}/recibidos/{idAviso} {
        allow read: if esMiembro(idDistribuidora)
          && idPersona == miIdPersona(idDistribuidora);

        // Cualquier miembro deja un aviso en el buzón de otro, a nombre
        // propio y sobre un pedido que existe.
        allow create: if esMiembro(idDistribuidora)
          && idPersonaValida(idPersona)
          && idPersona != miIdPersona(idDistribuidora)
          && avisoNuevoValido(idDistribuidora, request.resource.data);

        // Marcar como leído: solo el dueño del buzón, una sola vez.
        allow update: if esMiembro(idDistribuidora)
          && idPersona == miIdPersona(idDistribuidora)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["leido"])
          && resource.data.leido == null
          && request.resource.data.leido is number;

        // Limpiar los avisos viejos: solo el dueño del buzón.
        allow delete: if esMiembro(idDistribuidora)
          && idPersona == miIdPersona(idDistribuidora);
      }

      // Qué avisos recibe cada persona (T23). Los leen todos los miembros
      // (quien hace un cambio no le deja aviso a quien lo apagó); cada uno
      // cambia solo los suyos.
      match /preferenciasAvisos/{idPersona} {
        allow read: if esMiembro(idDistribuidora);

        allow create, update: if esMiembro(idDistribuidora)
          && idPersona == miIdPersona(idDistribuidora)
          && request.resource.data.keys().hasOnly(["apagados"])
          && request.resource.data.apagados is list
          && request.resource.data.apagados.size() <= 20;

        allow delete: if false;
      }
    }
  }
}
